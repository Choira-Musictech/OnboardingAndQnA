/// IPRS's REAL registration-payment table - already exists and is actively used in production
/// (mraai_uat, confirmed via real PayU transaction rows at the same fee amounts this app
/// charges). Replaces this app's own previously-invented App_Accounts_Payment table (see
/// scripts/add-regpayment-table.sql for the full story and PaymentStatus semantics: 0 = success,
/// 1 = failed - no row is written until a final result is known, matching how prod's own data
/// shows this table being used).
model AppAccountsRegPayment {
  PaymentRecieptId       BigInt    @id(map: "PK_App_Accounts_RegPayment") @default(autoincrement())
  AccountId              BigInt
  TransactionNo          String?   @unique(map: "UQ_App_Accounts_RegPayment_TransactionNo") @db.NVarChar(100)
  PaymentRecieptNo       String?   @db.NVarChar(100)
  PaymentStatus          Int?      @db.TinyInt
  PaymentGatewayResponse String?   @db.NVarChar(500)
  PaymentBankName        String?   @db.NVarChar(100)
  PaymentDate            DateTime? @db.DateTime
  ResponseNo             String?   @db.NVarChar(100)
  ResponseString         String?   @db.NVarChar(Max)
  LastTransactionNo      String?   @db.NVarChar(100)
  LastResponseNo         String?   @db.NVarChar(100)
  LastResponseString     String?   @db.NVarChar(Max)
  PaymentAmount          Float?    @db.Money
  PaidAmount             String?   @db.NVarChar(100)
  CreateDate             DateTime? @db.DateTime
  CreatedBy              String?   @db.NVarChar(100)
  ModifedBy              String?   @db.NVarChar(100)
  ModifedDate            DateTime? @db.DateTime

  @@index([AccountId], map: "IX_App_Accounts_RegPayment_AccountId")
  @@map("App_Accounts_RegPayment")
}


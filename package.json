{
  "name": "iprs-backend",
  "version": "1.0.0",
  "description": "IPRS Platform Backend - Week 1 (Onboarding & Platform Foundation)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "build:progress-map": "node scripts/build-progress-map.mjs",
    "setup:db": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "puppeteer": "25.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "puppeteer@25.12.0": true
  }
}

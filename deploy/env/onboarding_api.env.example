NODE_ENV=production
PORT=4001

DATABASE_URL="sqlserver://localhost:1433;database=Dreamsoft_UAT;user=iprs_app;password=REPLACE_WITH_DB_PASSWORD;encrypt=true;trustServerCertificate=true;"

JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_EXPIRES_IN=7d
JWT_ISSUER=iprs

CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5

OTP_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_MOCK_VALUE=123456

MSG91_AUT_KEY=
MSG91_TEMP_ID=
MSG91_OTP_LENGTH=4
MSG91_OTP_EXPIRY=10

DEFAULT_REGISTRATION_STATUS=started
REGISTRATION_TOTAL_STEPS=10

OCR_PROVIDER=http
OCR_API_BASE_URL=https://ocr.choira.io
OCR_REQUEST_TIMEOUT_MS=15000

TYPEBOT_API_BASE_URL=https://bot.choira.io
TYPEBOT_ID=iprs-onboarding
TYPEBOT_PREVIEW_MODE=false
TYPEBOT_API_TOKEN=
TYPEBOT_REQUEST_TIMEOUT_MS=15000
MAX_UPLOAD_SIZE_MB=10
# Every uploaded document is also copied here, one folder per member (<NAME>_<AccountId>/pan_card.jpg).
# Use an absolute path OUTSIDE the deploy folder, persistent and writable by the app user - a path
# inside the release directory is wiped on the next deploy. These are identity documents: never
# serve this folder over HTTP. Blank turns the copy off.
DOCUMENT_STORAGE_DIR=/home/iprs/member-documents

# --- Work links (Spotify / YouTube songs a member claims) ---
# In-house credits service. Role-labelled credits (composer / lyricist / producer) for both
# platforms; this is what fills Author_Composer and Author_Lyricist. One endpoint per platform:
#   Spotify  GET /credits?track=<url>    structured contributors with roles
#   YouTube  GET /youtube/raw?url=<url>  raw InnerTube, parsed in musicCredits.service.js
# All three have safe defaults in config/env.js - the app boots without them.
MUSIC_CREDITS_API_BASE_URL=https://spotify.choira.in
MUSIC_CREDITS_REQUEST_TIMEOUT_MS=30000
MUSIC_CREDITS_ENABLED=true

# Fallback path, used when the credits service is disabled, unreachable, or has nothing.
YOUTUBE_REQUEST_TIMEOUT_MS=10000
# Optional: blank means the YouTube title is shown unsplit rather than the step breaking.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_REQUEST_TIMEOUT_MS=15000

# Spotify Web API - the only source of album name / release year for a Spotify link.
# NOTE: currently 403s ("Active premium subscription required for the owner of the app"); the
# resolver degrades to credits-only and self-heals when the entitlement returns. See DEPLOY.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shown at the pre-payment review when a member says something needs correcting.
SUPPORT_CONTACT=Info@iprsolutions.in or theiprsolutions@gmail.com

# Blanket OCR kill-switch across every doc type.
OCR_ENABLED=true

# Blanket GST-verify kill-switch - set to false to test the chat flow past the GST step without a
# real, valid-format GSTIN on hand. Same shape/purpose as OCR_ENABLED.
GST_VERIFY_ENABLED=true

# --- SMTP / email OTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Envelope/visible "From" address - separate from SMTP_USER (the auth identity). Required on relays
# where SMTP_USER isn't a real mailbox (e.g. ZeptoMail's fixed username "emailapikey"). Falls back
# to SMTP_USER when unset.
SMTP_FROM=
EMAIL_OTP_LENGTH=4
EMAIL_OTP_EXPIRY_MINUTES=2
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

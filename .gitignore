# Dependencies
node_modules/
.pnp
.pnp.js

# Environment
# Every env variant is secret - only the committed template is tracked.
.env*
!.env.example

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
pino-log*

# Prisma
prisma/*.db
prisma/*.db-journal

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Member documents copied by documentStorage.service.js - identity documents, never commit
uploads/

# Temp
coverage/
.tmp/
# stray local backups - never commit (they usually contain secrets)
*.bak
*.bak.*
.env.bak*
